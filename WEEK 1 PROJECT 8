class Solution {
public:
    int myAtoi(string s) {
        int n = s.length();
        int i = 0;

        // Step 1: skip leading spaces
        while (i < n && s[i] == ' ') {
            i++;
        }

        // Step 2: check sign
        int sign = 1;
        if (i < n && (s[i] == '-' || s[i] == '+')) {
            if (s[i] == '-') {
                sign = -1;
            }
            i++;
        }

        // Step 3: read digits
        int result = 0;
        while (i < n && s[i] >= '0' && s[i] <= '9') {
            int digit = s[i] - '0';

            // Step 4: check overflow BEFORE multiplying
            if (result > INT_MAX / 10 || (result == INT_MAX / 10 && digit > 7)) {
                if (sign == 1) {
                    return INT_MAX;
                } else {
                    return INT_MIN;
                }
            }

            result = result * 10 + digit;
            i++;
        }

        return result * sign;
    }
};
