class Solution {
public:
    bool isPalindrome(int x) {
        // negative numbers are not palindromes
        if (x < 0) {
            return false;
        }

        long long rev = 0;
        int original = x;

        while (x != 0) {
            int digit = x % 10;       // last digit
            rev = rev * 10 + digit;   // add it to reversed number
            x = x / 10;               // remove last digit
        }

        return rev == original;
    }
};
