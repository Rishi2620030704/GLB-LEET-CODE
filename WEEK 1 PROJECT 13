class Solution {
public:
    int value(char c) {
        if (c == 'I') return 1;
        if (c == 'V') return 5;
        if (c == 'X') return 10;
        if (c == 'L') return 50;
        if (c == 'C') return 100;
        if (c == 'D') return 500;
        return 1000;   // 'M'
    }

    int romanToInt(string s) {
        int n = s.length();
        int total = 0;

        for (int i = 0; i < n; i++) {
            // if a next symbol exists and it is bigger, subtract current
            if (i + 1 < n && value(s[i]) < value(s[i + 1])) {
                total -= value(s[i]);
            } else {
                total += value(s[i]);
            }
        }

        return total;
    }
};
